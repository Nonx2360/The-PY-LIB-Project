# Secret material for THE PY-LIB (template — copy to .env)
#
# Leaving any value as this placeholder is SAFE: the app detects banned
# placeholder/short values on boot and replaces them with freshly generated
# random secrets, writing the real values to .env (gitignored).
#
# If SECRET_PASSPHRASE / SECRET_SALT ever change on an existing install,
# stored QR payloads must be re-encrypted with tools/rotate_qr_key.py —
# see docs/SECURITY.md before opening existing member data.
SECRET_PASSPHRASE=your_secret_school_library_passphrase_here
SECRET_SALT=your_secret_school_library_salt_here

# Flask session signing key (web UI). Auto-generated when missing.
FLASK_SECRET_KEY=your_flask_session_key_here
